table fakt_liquiditaet_tag
	lineageTag: 2c07a9ac-aad8-5b31-be1f-88101492266f

	measure 'Kontostand Stichtag' = LASTNONBLANKVALUE ( dim_datum[datum], SUM ( fakt_liquiditaet_tag[kontostand] ) )
		formatString: \$ #,0
		displayFolder: Liquidität
		lineageTag: 6ea22dd5-62ac-5be4-9afa-b7152ea27364

	measure 'Einzahlungen gesamt' = SUM ( fakt_liquiditaet_tag[einzahlungen] )
		formatString: \$ #,0
		displayFolder: Liquidität
		lineageTag: 05b3ebe8-0282-5979-9198-4d37cb5fa7dd

	measure Auszahlungen = SUM ( fakt_liquiditaet_tag[auszahlungen_ware] ) + SUM ( fakt_liquiditaet_tag[auszahlungen_versand] ) + SUM ( fakt_liquiditaet_tag[auszahlungen_fix] ) + SUM ( fakt_liquiditaet_tag[privatentnahme] )
		formatString: \$ #,0
		displayFolder: Liquidität
		lineageTag: def94f7d-d7d9-50b4-b339-8626fabff8b2

