table fakt_rechnungen
	lineageTag: 12869665-bdeb-54a4-8793-cad901f90eaf

	measure Rechnungsbetrag = SUM ( fakt_rechnungen[betrag] )
		formatString: \$ #,0
		displayFolder: Forderungen
		lineageTag: 589166ad-fe1a-54a3-9588-558a360dc88e

	measure 'Offene Forderungen' =
			VAR stichtag = MAX ( dim_datum[datum] )
			RETURN
			    CALCULATE (
			        SUM ( fakt_rechnungen[betrag] ),
			        REMOVEFILTERS ( dim_datum ),
			        fakt_rechnungen[rechnungsdatum] <= stichtag,
			        fakt_rechnungen[status] <> "uneinbringlich",
			        ISBLANK ( fakt_rechnungen[bezahlt_am] ) || fakt_rechnungen[bezahlt_am] > stichtag
			    )
		formatString: \$ #,0
		displayFolder: Forderungen
		lineageTag: 91839425-3e4d-5d8b-b04e-50566ee3d1dd

	measure 'Forderungslaufzeit (Tage)' = DIVIDE ( [Offene Forderungen], [Umsatz 12 Monate] ) * 365
		formatString: 0
		displayFolder: Forderungen
		lineageTag: 0da7467b-42ae-5489-944c-9a15e54a5276

	measure 'Ø Zahlungsverzug (Tage)' = CALCULATE ( AVERAGE ( fakt_rechnungen[verzug_tage] ), fakt_rechnungen[zahlungsziel_tage] > 0 )
		formatString: 0.0
		displayFolder: Forderungen
		lineageTag: de35fb09-626a-5d8d-af5b-9b206f2af346

