	partition fakt_rechnungen = m
		mode: import
		source =
				let
				    Quelle = Excel.Workbook(File.Contents(ExcelDatei), null, true),
				    Blatt = Quelle{[Item="fakt_rechnungen",Kind="Sheet"]}[Data],
				    Kopf = Table.PromoteHeaders(Blatt, [PromoteAllScalars=true]),
				    Typen = Table.TransformColumnTypes(Kopf, {{"auftrag_id", type text}, {"kunde_id", Int64.Type}, {"rechnungsdatum", type date}, {"faellig_am", type date}, {"bezahlt_am", type date}, {"betrag", Int64.Type}, {"zahlungsziel_tage", Int64.Type}, {"verzug_tage", Int64.Type}, {"status", type text}})
				in
				    Typen

	annotation PBI_ResultType = Table

